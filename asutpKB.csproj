<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>resources\app.ico</ApplicationIcon>
  </PropertyGroup>

  <Target Name="BlockDirectPublish" BeforeTargets="Publish" Condition="'$(AKB5AllowDirectPublish)' != 'true'">
    <Error Text="Direct publish of asutpKB.csproj is blocked because it does not package external modules. Use scripts\publish.ps1 or scripts\publish.cmd." />
  </Target>

  <ItemGroup>
    <Compile Remove="Models/**/*.cs" />
    <Compile Remove="Services/**/*.cs" />
    <Compile Remove="src/**/*.cs" />
    <Compile Remove="tests/**/*.cs" />
    <Compile Remove="artifacts/**/*.cs" />
    <Compile Remove="**/obj/**/*.cs" />
    <Compile Remove="**/bin/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Update="resources\app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="resources\fonts\MaterialSymbolsOutlined.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="Templates\Acts\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="src/AsutpKnowledgeBase.Core/AsutpKnowledgeBase.Core.csproj" />
  </ItemGroup>
</Project>
