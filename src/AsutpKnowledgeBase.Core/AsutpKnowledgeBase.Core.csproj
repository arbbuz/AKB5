<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Models/**/*.cs" Link="Models/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../Services/**/*.cs" Link="Services/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="../../resources/templates/maintenance-year-template.xlsx">
      <LogicalName>AsutpKnowledgeBase.Core.Resources.MaintenanceYearTemplate.xlsx</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="../../resources/templates/maintenance-annual-template.xlsx">
      <LogicalName>AsutpKnowledgeBase.Core.Resources.MaintenanceAnnualTemplate.xlsx</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.0.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.13" />
  </ItemGroup>
</Project>
